# Copier en .env.local pour le développement, et renseigner les mêmes
# variables dans Vercel (Project Settings → Environment Variables).

# URL publique du site, sans barre finale. À changer le jour où le domaine
# personnalisé est branché sur Vercel.
VITE_SITE_URL=https://combienjegarde.vercel.app

VITE_CONTACT_EMAIL=contact@combienjegarde.fr

# --- Vente du rapport PDF (laisser vide = bouton masqué) -------------------
# Lien de paiement Stripe en mode LIVE. Dans Stripe, régler la redirection
# après paiement sur :  <VITE_SITE_URL>/?pdf=success&session_id={CHECKOUT_SESSION_ID}
VITE_STRIPE_PAYMENT_LINK=
# Clé secrète Stripe (côté serveur uniquement, jamais préfixée par VITE_)
STRIPE_SECRET_KEY=

# Identité légale de l'éditeur, affichée dans les mentions légales et les CGV.
VITE_EDITEUR_NOM=
VITE_EDITEUR_SIRET=
VITE_EDITEUR_ADRESSE=
